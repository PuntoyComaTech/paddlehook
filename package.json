{
  "name": "@puntoycoma/paddlehook",
  "version": "1.3.0",
  "description": "Lightweight Paddle webhook verification and proxy for any edge runtime",
  "type": "module",
  "author": "PuntoyComaTech",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PuntoyComaTech/paddlehook.git"
  },
  "homepage": "https://github.com/PuntoyComaTech/paddlehook#readme",
  "bugs": {
    "url": "https://github.com/PuntoyComaTech/paddlehook/issues"
  },
  "keywords": [
    "paddle",
    "webhook",
    "cloudflare-workers",
    "supabase",
    "deno",
    "bun",
    "edge",
    "vercel",
    "netlify",
    "hono",
    "hmac",
    "proxy",
    "billing"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260404.1",
    "bun-types": "^1.3.11",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  }
}
